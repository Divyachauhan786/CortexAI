# =============================================================================
# CortexAI Workspace – Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# ─── MongoDB Atlas (external – not containerised) ────────────────────────────
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/ai-workspace

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_hex_string_64_chars_minimum
JWT_EXPIRES_IN=7d

# ─── Redis (managed internally by Docker Compose) ────────────────────────────
# Overridden automatically in docker-compose.yml; set here only for local dev
REDIS_URL=redis://localhost:6379

# ─── AI API Keys ─────────────────────────────────────────────────────────────
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-20b

GOOGLE_API_KEY=YOUR_GOOGLE_GENERATIVE_AI_API_KEY

TAVILY_API_KEY=YOUR_TAVILY_API_KEY

# ─── Qdrant (managed internally by Docker Compose) ───────────────────────────
# Overridden automatically in docker-compose.yml; set here only for local dev
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ai_workspace_documents

# ─── Frontend / CORS ─────────────────────────────────────────────────────────
# URL the browser uses to reach the gateway (must be reachable from the browser)
VITE_API_GATEWAY_URL=http://localhost:8000
# URL the backend services allow for CORS
FRONTEND_URL=http://localhost:5173

# ─── Firebase Client SDK (frontend) ──────────────────────────────────────────
# These are baked into the Vite build via docker compose build args
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ─── Firebase Admin SDK (auth-service) ───────────────────────────────────────
# Option A (recommended for Docker): mount the JSON file as a volume.
#   The file must exist at: services/auth-service/credentials/firebase-adminsdk.json
#   docker-compose.yml sets FIREBASE_CREDENTIALS_PATH=/app/credentials/firebase-adminsdk.json
#
# Option B (CI / secret manager): set the entire JSON as a single env var.
#   FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
#
# Rename your downloaded service-account JSON file to:
#   services/auth-service/credentials/firebase-adminsdk.json
